    {
      "name": "11. GET Pets Paginated and Sorted (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Page metadata reflects the request\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.content).to.be.an(\"array\");",
              "    pm.expect(j).to.have.property(\"totalElements\");",
              "    pm.expect(j).to.have.property(\"totalPages\");",
              "    pm.expect(j.size).to.eql(5);",
              "    pm.expect(j.number).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
