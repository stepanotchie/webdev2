  "item": [
    {
      "name": "1. GET All Pets - default page (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is a Page; remember an existing ownerId\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.content).to.be.an(\"array\");",
              "    pm.expect(j).to.have.property(\"totalElements\");",
              "    pm.expect(j.size).to.eql(20);",
              "    if (j.content.length > 0) { pm.collectionVariables.set(\"ownerId\", j.content[0].ownerId); }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pets"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. POST Create Pet (201 Created)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"petChip\", \"MC-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location header and body returned\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/pets/\" + j.id);",
              "    pm.expect(j.name).to.eql(\"Bella\");",
              "    pm.collectionVariables.set(\"petId\", j.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bella\",\n  \"species\": \"Dog\",\n  \"microChipNumber\": \"{{petChip}}\",\n  \"ownerId\": {{ownerId}},\n  \"contactEmail\": \"owner@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/pets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pets"
          ]
        }
      },
      "response": []
    },
